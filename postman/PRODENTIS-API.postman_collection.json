            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Prueba API\",\n  \"documentId\": \"99001234\",\n  \"birthDate\": \"1990-05-15\",\n  \"phone\": \"+54 11 5555-9999\",\n  \"email\": \"juan.prueba.api@test.com\",\n  \"address\": \"Av. Demo 123, CABA\",\n  \"status\": \"active\",\n  \"allergies\": \"Ninguna\",\n  \"medicalNotes\": \"Paciente creado desde Postman\"\n}"
            },
            "url": "{{baseUrl}}/patients",
            "description": "Validaciones: email válido, status enum, documentId único (409 si duplicado)."
          },
          "response": []
        },
        {
          "name": "Actualizar paciente",
          "request": {
            "method": "PUT",
