      "name": "Sistema",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Verifica que el servidor Express esté activo."
          },
          "response": []
        },
        {
          "name": "Bootstrap (todos los datos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/bootstrap",
            "description": "Devuelve pacientes, citas, facturas, inventario, etc. Usado por el frontend al iniciar."
          },
          "response": []
        }
      ]
    },
